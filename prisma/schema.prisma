generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  firstname  String?
  lastname   String?
  email      String?  @unique
  password   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  role_id    Int
  suffix     String?
  updatedAt  DateTime? @db.Timestamptz(6)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id        Int       @id @default(autoincrement())
  role      String   @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(2)
  updatedAt DateTime? @updatedAt @db.Timestamptz(2)
  users     users[]
}

model devices {
  id           Int       @id @default(autoincrement())
  ipAddress    String    @unique
  community    String?
  hostname     String?
  vendor       String?
  model        String?
  serialNumber String?   @unique
  macAddress   String?
  status       String    @default("1")

  sysName      String
  sysDescr     String    @db.Text
  sysContact   String?
  sysLocation  String?
  sysObjectID  String

  interfaces   interfaces[]

  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
}

model interfaces {
  id          Int      @id @default(autoincrement())

  deviceId    Int
  device      devices  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  index       Int
  name        String
  description String?

  adminStatus Int
  operStatus  Int
  status      String?

  speedMbps   Int?

  statistics  interface_statistics[]

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  
  @@unique([deviceId, index])
}

model interface_statistics {
  id Int @id @default(autoincrement())

  interfaceId Int

  interface interfaces @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  inOctets  BigInt
  outOctets BigInt

  inErrors  BigInt @default(0)
  outErrors BigInt @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}






model topologies {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  nodes       topology_nodes[]
  edges       topology_edges[]

  @@map("topologies")
}

model topology_nodes {
  id         Int      @id @default(autoincrement())
  topologyId Int
  
  nodeId     String

  type       String

  positionX  Float
  positionY  Float

  width      Float
  height     Float

  deviceId   Int?
  interfaceId Int?

  data       Json

  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  topology   topologies @relation( fields: [topologyId], references: [id], onDelete: Cascade)

  @@unique([topologyId, nodeId])
  @@index([topologyId])
  @@map("topology_nodes")
}

model topology_edges {
  id         Int      @id @default(autoincrement())
  topologyId Int

  edgeId     String

  sourceNodeId String 
  targetNodeId String

  sourceHandle String?
  targetHandle String?

  type       String?

  data       Json

  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  topology   topologies @relation( fields: [topologyId], references: [id], onDelete: Cascade)

  @@unique([topologyId, edgeId])
  @@index([topologyId])
  @@map("topology_edges")
}